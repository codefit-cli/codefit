  "Views": [
    {
      "Name": "actor_info",
      "Pos": {
        "File": "pagila_excerpt.sql",
        "Line": 65
      },
      "Body": {
        "Text": "CREATE VIEW public.actor_info AS\n SELECT a.actor_id,\n    a.first_name,\n    a.last_name\n   FROM public.actor a\n  GROUP BY a.actor_id, a.first_name, a.last_name",
        "Complete": true,
        "Note": ""
      }
    }
  ],
  "Procedures": [
    {
      "Name": "_group_concat",
      "Pos": {
        "File": "pagila_excerpt.sql",
        "Line": 47
      },
      "Body": {
        "Text": "CREATE FUNCTION public._group_concat(text, text) RETURNS text\n    LANGUAGE sql IMMUTABLE\n    AS $_$\nSELECT CASE\n  WHEN $2 IS NULL THEN $1\n  WHEN $1 IS NULL THEN $2\n  ELSE $1 || ', ' || $2\nEND\n$_$",
        "Complete": true,
        "Note": ""
      }
    },
    {
      "Name": "last_updated",
      "Pos": {
        "File": "pagila_excerpt.sql",
        "Line": 57
      },
      "Body": {
        "Text": "CREATE FUNCTION public.last_updated() RETURNS trigger\n    LANGUAGE plpgsql\n    AS $$\nBEGIN\n    NEW.last_update = CURRENT_TIMESTAMP;\n    RETURN NEW;\nEND $$",
        "Complete": true,
        "Note": ""
      }
    }
